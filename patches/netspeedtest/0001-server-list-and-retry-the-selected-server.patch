diff --git a/luci-app-netspeedtest/root/usr/libexec/rpcd/luci.netspeedtest b/luci-app-netspeedtest/root/usr/libexec/rpcd/luci.netspeedtest
new file mode 100755
index 0000000..e96eb02
--- /dev/null
+++ b/luci-app-netspeedtest/root/usr/libexec/rpcd/luci.netspeedtest
@@ -0,0 +1,6 @@
+#!/bin/sh
+# rpcd backend for luci-app-netspeedtest: get_servers (already granted by the ACL)
+case "$1" in
+	list) echo '{ "get_servers": {} }' ;;
+	call) case "$2" in get_servers) exec /usr/bin/python3 /usr/share/netspeedtest/servers.py ;; esac ;;
+esac
diff --git a/luci-app-netspeedtest/root/usr/share/netspeedtest/servers.py b/luci-app-netspeedtest/root/usr/share/netspeedtest/servers.py
new file mode 100644
index 0000000..ab301d3
--- /dev/null
+++ b/luci-app-netspeedtest/root/usr/share/netspeedtest/servers.py
@@ -0,0 +1,34 @@
+# Speedtest.net servers for the LuCI dropdown: the nearest ones Ookla reports
+# plus a few in nearby regions. Cached for a day in /tmp.
+import json, os, subprocess, time, urllib.request, urllib.parse
+CACHE = "/tmp/netspeedtest_servers.json"
+if os.path.exists(CACHE) and time.time() - os.path.getmtime(CACHE) < 86400:
+    print(open(CACHE).read()); raise SystemExit
+CN = {"China": "中国大陆", "Hong Kong": "中国香港", "Macau": "中国澳门", "Macao": "中国澳门", "Taiwan": "中国台湾",
+      "Japan": "日本", "South Korea": "韩国", "Korea": "韩国", "Singapore": "新加坡"}
+servers, seen = [], set()
+def add(sid, sponsor, city, country, group):
+    sid = int(sid)
+    if sid in seen: return
+    seen.add(sid)
+    servers.append({"id": sid, "group": group, "country": country,
+                    "label": "%s · %s · %s（%d）" % (CN.get(country, country), city, sponsor, sid)})
+try:
+    out = subprocess.run(["/usr/bin/ookla-speedtest", "--accept-license", "--accept-gdpr", "-L", "-f", "json"],
+                         capture_output=True, text=True, timeout=20).stdout
+    for s in json.loads(out).get("servers", []):
+        add(s["id"], s["name"], s["location"], s["country"], "nearest")
+except Exception:
+    pass
+for q in ["Hong Kong", "Macau", "Taipei", "Tokyo", "Osaka", "Seoul", "Singapore"]:
+    try:
+        url = "https://www.speedtest.net/api/js/servers?engine=js&limit=6&search=" + urllib.parse.quote(q)
+        for s in json.load(urllib.request.urlopen(url, timeout=6)):
+            add(s["id"], s["sponsor"], s["name"], s["country"], "region")
+    except Exception:
+        pass
+servers.sort(key=lambda s: (s["country"] != "China", s["group"] != "nearest"))
+res = json.dumps({"servers": servers}, ensure_ascii=False)
+if servers:
+    open(CACHE, "w").write(res)
+print(res)
