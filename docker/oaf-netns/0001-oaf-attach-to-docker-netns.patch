+
+/*
+ * netns support: attach oaf to the network namespace of a process instead of
+ * init_net, e.g. an OpenWrt docker container:
+ *   insmod oaf.ko netns_pid=$(docker inspect -f '{{.State.Pid}}' OpenWrt)
+ * No reference is held on that namespace. When it is torn down (container
+ * stopped) oaf detaches itself and stays idle until it is reloaded.
+ */
+static int netns_pid;
+module_param(netns_pid, int, 0444);
+MODULE_PARM_DESC(netns_pid, "attach to the network namespace of this pid (0 = init_net)");
+struct net *fwx_net = &init_net;
+static atomic_t fwx_net_attached = ATOMIC_INIT(0);
 struct list_head af_feature_head = LIST_HEAD_INIT(af_feature_head);
 
 DEFINE_RWLOCK(af_feature_lock);
@@ -2146,7 +2160,7 @@ static int af_should_send_tcp_rst(struct sk_buff *skb, flow_info_t *flow)
 static void af_send_tcp_reset(struct sk_buff *skb)
 {
 #if LINUX_VERSION_CODE > KERNEL_VERSION(5,10,197)
-	nf_send_reset(&init_net, skb->sk, skb, NF_INET_PRE_ROUTING);
+	nf_send_reset(fwx_net, skb->sk, skb, NF_INET_PRE_ROUTING);
 #elif LINUX_VERSION_CODE > KERNEL_VERSION(4,4,1)
 
 
@@ -2711,6 +2725,8 @@ int af_send_msg_to_user(char *pbuf, uint16_t len)
