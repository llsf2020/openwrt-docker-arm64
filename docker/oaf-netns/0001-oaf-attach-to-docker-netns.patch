-	fwx_sock = netlink_kernel_create(&init_net, FWX_NETLINK_ID, &nl_cfg);
+	fwx_sock = netlink_kernel_create(fwx_net, FWX_NETLINK_ID, &nl_cfg);
 
 	if (NULL == fwx_sock)
 	{
@@ -2815,9 +2831,56 @@ void af_active_app_clean_procfs(void);
 int af_active_host_init_procfs(void);
 void af_active_host_clean_procfs(void);
 
+/* tear down everything that lives in fwx_net; runs once (netns exit or rmmod) */
+static void fwx_detach_net(void)
+{
+	if (!atomic_xchg(&fwx_net_attached, 0))
+		return;
+	AF_INFO("fwx: detach from netns\n");
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(4, 3, 0)
+	nf_unregister_net_hooks(fwx_net, fwx_ops, ARRAY_SIZE(fwx_ops));
+#else
+	nf_unregister_hooks(fwx_ops, ARRAY_SIZE(fwx_ops));
+#endif
+	fini_fwx_timer();
+	af_client_exit();
+	finit_af_client_procfs();
+	af_active_app_clean_procfs();
+	af_active_host_clean_procfs();
+	af_conn_remove_procfs();
+	if (fwx_sock)
+	{
+		netlink_kernel_release(fwx_sock);
+		fwx_sock = NULL;
+	}
+}
+
+static void fwx_net_pre_exit(struct net *net)
+{
+	if (net == fwx_net)
+		fwx_detach_net();
+}
+
+static struct pernet_operations fwx_net_ops = {
+	.pre_exit = fwx_net_pre_exit,
+};
+
 static int __init fwx_init(void)
 {
 	int err;
+	struct net *net = NULL;
+
+	if (netns_pid > 0)
+	{
+		net = get_net_ns_by_pid(netns_pid);
+		if (IS_ERR(net))
+		{
+			AF_ERROR("fwx: no netns for pid %d\n", netns_pid);
+			return PTR_ERR(net);
+		}
+		fwx_net = net;
+		AF_INFO("fwx: attach to netns of pid %d\n", netns_pid);
+	}
 	af_conn_init();
 	netlink_fwx_init();
 	af_log_init();
@@ -2829,7 +2892,7 @@ static int __init fwx_init(void)
 	fwx_mac_filter_init();
 	fwx_app_filter_init();
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(4, 3, 0)
-	err = nf_register_net_hooks(&init_net, fwx_ops, ARRAY_SIZE(fwx_ops));
+	err = nf_register_net_hooks(fwx_net, fwx_ops, ARRAY_SIZE(fwx_ops));
 #else
 	err = nf_register_hooks(fwx_ops, ARRAY_SIZE(fwx_ops));
 #endif
@@ -2838,6 +2901,13 @@ static int __init fwx_init(void)
 		AF_ERROR("fwx register filter hooks failed!\n");
 	}
 	init_fwx_timer();
+	atomic_set(&fwx_net_attached, 1);
+	/* get told when fwx_net goes away; only then drop our temporary reference */
+	err = register_pernet_subsys(&fwx_net_ops);
+	if (err)
+		AF_ERROR("fwx register pernet ops failed!\n");
+	if (net)
+		put_net(net);
 	AF_INFO("fwx: Driver ver. %s - Copyright(c) 2026, fanchmwrt, <www.fanchmwrt.com>\n", FWX_VERSION);
 	AF_INFO("fwx: init ok\n");
 	return 0;
@@ -2846,26 +2916,16 @@ static int __init fwx_init(void)
 static void fwx_fini(void)
 {
 	AF_INFO("fwx module exit\n");
-	fini_fwx_timer();
-#if LINUX_VERSION_CODE >= KERNEL_VERSION(4, 3, 0)
-	nf_unregister_net_hooks(&init_net, fwx_ops, ARRAY_SIZE(fwx_ops));
-#else
-	nf_unregister_hooks(fwx_ops, ARRAY_SIZE(fwx_ops));
-#endif
-	finit_af_client_procfs();
-	af_active_app_clean_procfs();
-	af_active_host_clean_procfs();
+	unregister_pernet_subsys(&fwx_net_ops);
+	fwx_detach_net();
 	af_clean_feature_list();
 	af_clear_active_app_list();
 	af_clear_active_host_list();
 	af_log_exit();
-	af_client_exit();
 	fwx_app_filter_exit();
 	fwx_mac_filter_exit();
 	fwx_unregister_dev();
-	if (fwx_sock)
-		netlink_kernel_release(fwx_sock);
-	af_conn_exit();
+	af_conn_cleanup();
 	return;
 }
 
